---
import { statSync } from 'node:fs';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  /** Path under public/, e.g. "/whitepapers/name.pdf" (stable, unhashed URL). */
  file: string;
  description?: string;
  pages?: number;
  cover?: ImageMetadata;
}

const { title, file, description, pages, cover } = Astro.props;

// Link respects the /blog base without adding a trailing slash (it's a file).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = file.startsWith('/') ? file : `/${file}`;
const href = `${base}${path}`;

// File size, read at build. Gracefully skipped if the PDF isn't in place yet.
function humanSize(): string | null {
  try {
    const bytes = statSync(`public${path}`).size;
    if (bytes < 1024) return `${bytes} B`;
    const kb = bytes / 1024;
    return kb < 1024 ? `${Math.round(kb)} KB` : `${(kb / 1024).toFixed(1)} MB`;
  } catch {
    return null;
  }
}
const meta = ['PDF', pages ? `${pages} pages` : null, humanSize()]
  .filter(Boolean)
  .join(' · ');
---

<aside class="wp-card">
  {cover && (
    <Image
      class="wp-cover"
      src={cover}
      alt={`${title} — cover`}
      widths={[160, 320]}
      sizes="120px"
      loading="lazy"
    />
  )}
  <div class="wp-body">
    <p class="wp-eyebrow">White paper</p>
    <p class="wp-title">{title}</p>
    {description && <p class="wp-desc">{description}</p>}
    <p class="wp-meta">{meta}</p>
    <a
      class="wp-btn"
      href={href}
      target="_blank"
      rel="noopener"
      aria-label={`Download the white paper: ${title} (PDF)`}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Download the white paper
    </a>
  </div>
</aside>

<style>
  .wp-card {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-code-bg);
  }

  .wp-cover {
    flex: 0 0 120px;
    width: 120px;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }

  .wp-body {
    min-width: 0;
  }

  .wp-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-link);
  }

  .wp-title {
    margin: var(--space-xs) 0 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
  }

  .wp-desc {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .wp-meta {
    margin: var(--space-sm) 0 var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .wp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    background: var(--color-link);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: filter 0.15s, transform 0.15s;
  }

  .wp-btn:hover {
    filter: brightness(1.08);
    text-decoration: none;
  }

  .wp-btn:active {
    transform: translateY(1px);
  }

  .wp-btn:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  @media (max-width: 34rem) {
    .wp-card {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }
</style>
